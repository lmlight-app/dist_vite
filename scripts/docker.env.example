# DigitalBase (docker compose) の設定。docker-compose.yml と同じ dir に .env として置く。
# 行は全部任意 (無い値は既定)。ここに書いた行は compose の変数にもアプリの環境変数にもなる。
# 他の設定項目は 管理画面 > 環境変数 (または docs の「環境変数一覧」) を参照。

# ── compose の値 ───────────────────────────────────────────────
#APP_PORT=8000                 # ホスト側の待ち受けポート
#LLM_BACKEND=ollama            # ollama | vllm (= 推論エンジン。docker-compose.vllm.yml を重ねる時は vllm 固定)
#DB_IMAGE_TAG=latest           # 本番は x2026MMDD 形式の版で固定する
#DB_PASSWORD=digitalbase       # 同梱 PostgreSQL のパスワード (初回起動前に決める。後から変えると DB に入れなくなる)

# ── 既存の PostgreSQL / LLM を使う (書いた時だけ有効。db サービスは消してよい) ──
#DATABASE_URL=postgresql://digitalbase:password@db.example.local:5432/digitalbase
#OLLAMA_BASE_URL=http://host.docker.internal:11434
#VLLM_BASE_URL=http://host.docker.internal:8080
#VLLM_EMBED_BASE_URL=http://host.docker.internal:8081

# ── docker-compose.vllm.yml (GPU 同梱) の値 ─────────────────────
#VLLM_CHAT_MODEL=Qwen/Qwen3-4B
#VLLM_EMBED_MODEL=Qwen/Qwen3-Embedding-0.6B
#LLM_CONTEXT_LENGTH=32768
#VLLM_GPU_MEMORY_UTILIZATION_CHAT=0.70
#VLLM_GPU_MEMORY_UTILIZATION_EMBED=0.10
#VLLM_IMAGE_TAG=latest
#HF_TOKEN=

# ── アプリ (よく使うもの) ────────────────────────────────────────
#OPENAI_API_KEY=               # cloud モデルを併用する時
#ANTHROPIC_API_KEY=
#AUTH_MODE=local               # local | ldap | oidc
#JWT_SECRET=                   # 未指定なら初回起動時に data/ に生成して永続 (固定したい時だけ書く)
#OAUTH_ENCRYPTION_KEY=         # 同上。変えると保存済みの OAuth 連携が読めなくなる
